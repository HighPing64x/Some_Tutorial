---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

export async function getStaticPaths() {
  const articles = await getCollection("blog", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const sections = headings.filter(({ depth }) => depth === 2);
---

<SiteLayout title={article.data.title} description={article.data.description}>
  <article class="article-page">
    <a class="article-back" href={`${base}#articles`}><span aria-hidden="true">←</span> 返回文章列表</a>
    <header class="article-header">
      <span class="article-category">{article.data.category}</span>
      <h1 class="article-title">{article.data.title}</h1>
      <p class="article-description">{article.data.description}</p>
      <time class="article-date" datetime={article.data.pubDate.toISOString()}>{dateFormatter.format(article.data.pubDate)}</time>
    </header>
    {sections.length > 0 && (
      <nav class="article-toc" aria-label="文章章节导航">
        <span>本文目录</span>
        <ol>
          {sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose" data-pagefind-body>
      <Content />
    </div>
  </article>
</SiteLayout>

<style>
  .article-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    column-gap: 40px;
    max-width: 1120px;
  }

  .article-back,
  .article-header {
    grid-column: 1 / -1;
  }

  .article-toc {
    position: sticky;
    top: 24px;
    z-index: 1;
    align-self: start;
    grid-column: 2;
    grid-row: 3;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    margin: 0;
    padding: 14px 10px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper);
  }

  .article-toc > span {
    display: block;
    margin: 0 8px 9px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }

  .article-toc ol {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-toc a {
    display: block;
    padding: 6px 8px;
    border-radius: 2px;
    color: var(--green);
    font-size: 12px;
    line-height: 1.55;
    text-decoration: none;
  }

  .article-toc a:hover {
    color: var(--green-dark);
    background: #edf4ef;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose {
    grid-column: 1;
    grid-row: 3;
    padding-top: 0;
  }

  @media (max-width: 1100px) {
    .article-page {
      display: block;
      max-width: 900px;
    }

    .article-toc {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      gap: 16px;
      overflow-x: auto;
      max-height: none;
      margin: 14px 0 22px;
      padding: 11px 14px;
    }

    .article-toc > span {
      flex: 0 0 auto;
      margin: 0;
    }

    .article-toc ol {
      display: flex;
      gap: 18px;
      width: max-content;
      white-space: nowrap;
    }

    .article-toc a {
      padding: 0;
    }

    .article-toc a:hover {
      background: transparent;
    }

    .prose {
      padding-top: 24px;
    }
  }
</style>
